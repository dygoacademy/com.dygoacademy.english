# Dygo Academy — local environment template.
# Copy to .env at the repo root: `cp .env.example .env`
# The NestJS API reads this same file (see app.module.ts envFilePath), and
# docker-compose.yml interpolates these same names. See README.md §1 for the
# full setup walkthrough, including how to generate the two Supabase keys.

# ---------------------------------------------------------------------------
# Core / API
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (Supabase Postgres, via docker-compose)
# ---------------------------------------------------------------------------
# Local superuser password for the `postgres` role. Also used to derive the
# default DATABASE_URL / DATABASE_ADMIN_URL below if you keep them as-is.
POSTGRES_PASSWORD=postgres_password_local_dev

# `authenticator` role — same role PostgREST uses, so RLS applies to API
# traffic too. Never used for DDL.
DATABASE_URL=postgresql://authenticator:postgres_password_local_dev@localhost:5432/postgres
DATABASE_POOL_MAX=20

# Superuser connection, used only for DDL the API role must not have
# (review_logs partition maintenance). Never used to serve a request.
DATABASE_ADMIN_URL=postgresql://postgres:postgres_password_local_dev@localhost:5432/postgres

# ---------------------------------------------------------------------------
# Supabase (GoTrue / PostgREST / Kong / Studio)
# ---------------------------------------------------------------------------
SUPABASE_URL=http://localhost:8000
JWT_EXPIRY=3600

# Must be >= 32 chars — signs every access token minted by GoTrue and by
# `npm run token` in the backend. Any string works for local dev.
SUPABASE_JWT_SECRET=

# These are NOT random strings — they are HS256 JWTs signed with
# SUPABASE_JWT_SECRET above. Generate both with the script in README.md §1
# ("Generating the anon / service_role keys") every time you change the
# secret above; a mismatched pair fails silently as 401s.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# pg-meta's at-rest encryption key for connection secrets it stores.
# Generate with: openssl rand -hex 16
PG_META_CRYPTO_KEY=

# ---------------------------------------------------------------------------
# Redis (BullMQ — enrichment / notification-cron / maintenance queues)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# RUSTFS_* / STORAGE_S3_BUCKET / STORAGE_TENANT_ID below configure
# docker-compose's own `rustfs` + `storage-api` services (Supabase's Storage
# feature; RustFS replaced MinIO on 2026-10-04). The app's own audio uploads
# go to Cloudflare R2 (see StorageService / configuration.ts `storage`), not
# here. Set your own RUSTFS keys (any strings; the secret 16+ characters).
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me-to-a-long-random-string
STORAGE_S3_BUCKET=supabase-storage
STORAGE_REGION=us-east-1
STORAGE_TENANT_ID=dygo-local

# App media (word + speaking audio), option 2 since 2026-10-04: stored in
# RustFS (the docker-compose `rustfs` service, bucket `media`, keys above)
# and served at https://media.dygoacademy.com through the Cloudflare Tunnel.
# Each clip is stored as AAC .m4a (linked) plus a .wav copy at the same key.
# STORAGE_PROVIDER=r2 switches back to Cloudflare R2 (R2_* below).
STORAGE_PROVIDER=rustfs
MEDIA_PUBLIC_URL=https://media.dygoacademy.com
MEDIA_BUCKET=media
RUSTFS_ENDPOINT=http://127.0.0.1:9100

# Cloudflare R2 — only used with STORAGE_PROVIDER=r2 (and by the one-off
# R2 → RustFS media migration script). Get these from the Cloudflare dashboard -> R2 -> Manage API
# tokens, and a public bucket URL from R2 -> your bucket -> Settings ->
# Public access.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dygo-audio
R2_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Third-party integrations — mock values are fine until you reach the phase
# that uses them (Words/AI enrichment: Phase 1 · Billing: Phase 4 ·
# Push notifications: Phase 3).
# ---------------------------------------------------------------------------
# Module 2 (EnrichmentProcessor): Gemini 1.5 Flash for linguistic fields,
# Gemini TTS for audio — see src/ai/gemini-enrichment.service.ts.
GEMINI_API_KEY=
# Phase 13 speech scorers (docker compose services `speech`, `speech-2`,
# README "Speech checking"), comma-separated; one is fine. Default
# http://127.0.0.1:8100. UAT: http://127.0.0.1:8100,http://127.0.0.1:8101
SPEECH_SCORER_URLS=
# Phase 13 S13: daily caps on paid Google APIs (UTC days, table
# api_usage_daily). Over the cap the call is skipped. Defaults 1000 Gemini
# calls and 300000 Google TTS characters a day.
GEMINI_DAILY_CALL_LIMIT=
GOOGLE_TTS_DAILY_CHAR_LIMIT=
SPEECH_CHECK_TIMEOUT_MS=
STRIPE_SECRET_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@dygo.test
