{
  "name": "com.dygoacademy.backend",
  "version": "0.1.0",
  "description": "Dygo Academy — NestJS modular monolith API",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "token": "node scripts/dev-token.js",
    "test-push": "node scripts/test-push.js",
    "test-push:local": "sh -c 'set -a; . ../env-profiles/local.env; set +a; node scripts/test-push.js \"$1\"' --",
    "test-push:stg": "sh -c 'set -a; . ../env-profiles/stg.env; set +a; node scripts/test-push.js \"$1\"' --",
    "test-push:prod": "sh -c 'set -a; . ../env-profiles/prod.env; set +a; node scripts/test-push.js \"$1\"' --",
    "audio-backfill": "node scripts/audio-backfill.js",
    "audio-backfill:local": "sh -c 'set -a; . ../env-profiles/local.env; set +a; node scripts/audio-backfill.js \"$@\"' --",
    "audio-backfill:prod": "sh -c 'set -a; . ../env-profiles/prod.env; set +a; node scripts/audio-backfill.js \"$@\"' --",
    "media-migrate": "ts-node --transpile-only scripts/media-migrate.ts",
    "speaking-generate": "ts-node --transpile-only scripts/speaking-generate.ts",
    "speaking-generate:prod": "sh -c 'set -a; . ../env-profiles/prod.env; set +a; ts-node --transpile-only scripts/speaking-generate.ts \"$@\"' --",
    "translations-backfill": "node scripts/translations-backfill.js",
    "translations-backfill:local": "sh -c 'set -a; . ../env-profiles/local.env; set +a; node scripts/translations-backfill.js \"$@\"' --",
    "translations-backfill:prod": "sh -c 'set -a; . ../env-profiles/prod.env; set +a; node scripts/translations-backfill.js \"$@\"' --",
    "relations-import": "node scripts/relations-import.js",
    "relations-import:prod": "sh -c 'set -a; . ../env-profiles/prod.env; set +a; node scripts/relations-import.js \"$@\"' --",
    "start:dev:local": "sh -c 'set -a; . ../env-profiles/local.env; set +a; nest start --watch'",
    "start:dev:stg": "sh -c 'set -a; . ../env-profiles/stg.env; set +a; nest start --watch'",
    "start:prod:domain": "sh -c 'set -a; . ../env-profiles/prod.env; set +a; node dist/main'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1122.0",
    "@google/genai": "^2.19.0",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "bullmq": "^5.34.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-fsrs": "5.4.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage"
  }
}
