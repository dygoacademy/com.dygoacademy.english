# Dygo Academy frontend — local environment template.
# Copy to .env.local: `cp .env.example .env.local`
# Only NEXT_PUBLIC_-prefixed vars are exposed to the browser; keep the
# service_role key out of this file entirely.

# NestJS API — see com.dygoacademy.backend, defaults to port 3001.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Supabase — same project as the root .env, but only the URL and anon key
# (never the service_role key) belong on the client.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Word Garden UI rebuild (ui rebuild implementation plan.md). "true" sends
# every signed-in user from "/" to the new /garden screens. Leave unset for
# the classic UI; a single browser can opt in with ?ui=garden (cookie) and
# back out with ?ui=classic.
# NEXT_PUBLIC_GARDEN_UI=true
