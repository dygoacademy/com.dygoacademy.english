# Dygo Academy — production reverse proxy.
#
# Caddy gets and renews Let's Encrypt certs for each domain below
# automatically, as long as DNS for all three points at this machine's
# public IP and ports 80+443 reach it (see the DNS/port-forward notes
# handed over separately). No manual cert config needed.
#
# Three subdomains, mirroring the exact host:port pattern .env.stg already
# used (localhost:3000/3001/8000) — see .env.prod's own header comment.

dygoacademy.com {
	redir https://www.dygoacademy.com{uri} permanent
}

www.dygoacademy.com {
	reverse_proxy localhost:3000
}

api.dygoacademy.com {
	reverse_proxy localhost:3001
}

supabase.dygoacademy.com {
	reverse_proxy localhost:8000
}
