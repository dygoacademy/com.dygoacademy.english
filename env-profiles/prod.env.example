# Template for env-profiles/prod.env — copy with:
#   cp env-profiles/prod.env.example env-profiles/prod.env
# Fill in your own domain. Cloudflare R2 credentials go in the root .env
# now (shared across every profile) — see that file's storage section.

NODE_ENV=production
FRONTEND_URL=https://www.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://supabase.yourdomain.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Serve the garden:diff reference pages (/garden/_reference/...) in this
# production build so the pixel diff can run against UAT. Public while on.
# GARDEN_REFERENCE_PAGES=on

# Voice donation (`docs/plans/Voice donation consent plan.md`). Off unless "true"; UAT
# only until the Terms / Privacy text has a lawyer's review. Backend:
# VOICE_DONATION_ENABLED, plus VOICE_DONATION_KEY (32 random bytes, base64:
# `openssl rand -base64 32`; donated recordings are encrypted with it, and
# nothing is kept without it; keep a copy, it can't be recovered).
# Frontend (baked in at `next build`): NEXT_PUBLIC_VOICE_DONATION.
# VOICE_DONATION_ENABLED=false
# VOICE_DONATION_KEY=
# VOICE_DONATION_BUCKET=voice-donations
# Which recordings are kept (docs/plans/Voice donation quality plan.md); these are the defaults:
# VOICE_DONATION_MAX_PER_PROMPT=2
# VOICE_DONATION_MAX_PER_DAY=20
# VOICE_DONATION_SAMPLE_RATE=0.2
# VOICE_DONATION_PROMPT_REGION_QUOTA=30
# NEXT_PUBLIC_VOICE_DONATION=false
