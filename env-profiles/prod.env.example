# Template for env-profiles/prod.env — copy with:
#   cp env-profiles/prod.env.example env-profiles/prod.env
# Fill in your own domain. Cloudflare R2 credentials go in the root .env
# now (shared across every profile) — see that file's storage section.

NODE_ENV=production
FRONTEND_URL=https://www.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://supabase.yourdomain.com
