# Template for env-profiles/local.env — copy with:
#   cp env-profiles/local.env.example env-profiles/local.env
# Every value below is already what the app falls back to with nothing set,
# so the copy works unedited. See local.env's own header (once copied) or
# README.md "Running modes" for what this file is and why it lives here.
# Cloudflare R2 credentials go in the root .env, not here — shared across
# every profile.

FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
